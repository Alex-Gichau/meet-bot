/**
 * Generates and emails the 7-Day Google Meet Report using a key-value text block format.
 */
function send7DayReport() {
  var days = 7;
  var now = new Date();
  var pastDate = new Date(now.getTime() - (days * 24 * 60 * 60 * 1000));
  var startTime = pastDate.toISOString();

  try {
    // 1. Fetch Google Meet audit logs from Admin SDK Reports API
    var response = AdminReports.Activities.list('all', 'meet', {
      startTime: startTime,
      maxResults: 1000
    });

    var activities = response.items;

    if (!activities || activities.length === 0) {
      Logger.log("No Google Meet activity found in the last " + days + " days.");
      return;
    }

    // 2. Aggregate raw event data treating recurring instances independently
    var meetingMap = {};

    activities.forEach(function(event) {
      var organizer = event.actor ? event.actor.email : "Unknown";
      var meetingCode = "Unknown";
      var calendarEventId = "N/A";
      var conferenceId = "N/A";
      var clientType = "Unknown";
      var packetLoss = 0;
      var jitter = 0;
      var eventTime = new Date(event.id.time);

      if (event.events && event.events.length > 0) {
        var parameters = event.events[0].parameters;
        if (parameters) {
          parameters.forEach(function(param) {
            if (param.name === 'meeting_code') meetingCode = String(param.value || "").trim();
            if (param.name === 'calendar_event_id') calendarEventId = String(param.value || "").trim();
            if (param.name === 'conference_id') conferenceId = String(param.value || "").trim();
            if (param.name === 'client_type') clientType = String(param.value || "Unknown").toUpperCase();
            if (param.name === 'mean_packet_loss_percentage') {
              var parsedLoss = parseFloat(param.floatValue);
              if (!isNaN(parsedLoss) && isFinite(parsedLoss)) packetLoss = parsedLoss;
            }
            if (param.name === 'mean_jitter_msec') {
              var parsedJitter = parseInt(param.intValue, 10);
              if (!isNaN(parsedJitter) && isFinite(parsedJitter)) jitter = parsedJitter;
            }
          });
        }
      }

      if (meetingCode !== "Unknown" && meetingCode !== "") {
        // Unique composite key ensures recurring meetings/instances are tracked independently
        var mapKey = meetingCode + "_" + (calendarEventId !== "N/A" ? calendarEventId : conferenceId);

        if (!meetingMap[mapKey]) {
          meetingMap[mapKey] = {
            meetingCode: meetingCode,
            organizer: organizer,
            calendarEventId: calendarEventId,
            conferenceIds: {},
            clientTypes: {},
            activitiesList: [],
            sumPacketLoss: 0,
            sumJitter: 0,
            qualityRecords: 0
          };
        }

        var m = meetingMap[mapKey];

        if (m.calendarEventId === "N/A" && calendarEventId !== "N/A") {
          m.calendarEventId = calendarEventId;
        }

        // Track unique conference IDs
        if (conferenceId !== "N/A") {
          m.conferenceIds[conferenceId] = true;
        }

        // Track client types
        if (clientType !== "UNKNOWN") {
          m.clientTypes[clientType] = (m.clientTypes[clientType] || 0) + 1;
        }

        m.activitiesList.push({
          time: eventTime,
          packetLoss: packetLoss,
          jitter: jitter
        });

        if (packetLoss > 0 || jitter > 0) {
          m.sumPacketLoss += packetLoss;
          m.sumJitter += jitter;
          m.qualityRecords += 1;
        }
      }
    });

    // 3. Format into key-value text blocks (Filtered by Scheduled Duration >= 12 mins)
    var blocksHtml = "";
    var meetingKeys = Object.keys(meetingMap);
    var filteredCount = 0;

    meetingKeys.forEach(function(key) {
      var data = meetingMap[key];

      // Fetch Event details, scheduled timing, recurrence, and start/end dates
      var calendarInfo = getCalendarEventDetails(data.calendarEventId, data.organizer);

      // FILTER: Process meetings with a calendar scheduled duration >= 12 minutes (720 seconds)
      if (calendarInfo.durationSec >= 720) {
        filteredCount++;

        // Calculate participant sessions count based on unique conference IDs
        var totalConferences = Object.keys(data.conferenceIds).length;
        var participantSessions = totalConferences > 0 ? totalConferences : data.activitiesList.length;

        // Build Client Type summary string
        var clientSummary = formatClientTypes(data.clientTypes);

        var avgLoss = data.qualityRecords > 0 ? (data.sumPacketLoss / data.qualityRecords).toFixed(1) + "%" : "-";
        var avgJitter = data.qualityRecords > 0 ? Math.round(data.sumJitter / data.qualityRecords) + " ms" : "-";

        blocksHtml += '<div style="margin-bottom: 25px; line-height: 1.6; font-size: 14px;">' +
          '<strong>Event Title :</strong> <i>' + calendarInfo.title + '</i><br>' +
          '<strong>Meeting Code :</strong> ' + data.meetingCode.toUpperCase() + '<br>' +
          '<strong>Participant Sessions :</strong> ' + participantSessions + '<br>' +
          '<strong>Client Types :</strong> ' + clientSummary + '<br>' +
          '<strong>Total Duration :</strong> ' + calendarInfo.formattedDuration + '<br>' +
          '<div style="border-bottom: 1px dashed #ccc; margin: 8px 0; width: 300px;"></div>' +
          '<strong>Event Details :</strong> ' + calendarInfo.description + '<br>' +
          '<strong>Event Date :</strong> ' + calendarInfo.scheduledTime + '<br>' +
          '<strong>Recurring Meeting :</strong> ' + calendarInfo.repeatDays + '<br>' +
          '<strong>Avg. Packet Loss :</strong> ' + avgLoss + '<br>' +
          '<strong>Avg. Jitter :</strong> ' + avgJitter +
        '</div>' +
        '<hr style="border: 0; border-top: 1px solid #e0e0e0; margin: 20px 0;">';
      }
    });

    if (filteredCount === 0) {
      blocksHtml = '<p style="color: #777;">No meetings found exceeding 12 minutes in the last 7 days.</p>';
    }

    // 4. Construct Email Body
    var htmlBody = '<div style="font-family: Arial, sans-serif; color: #333; max-width: 650px;">' +
      '<h2>Google Meet Report (Last 7 Days)</h2>' +
      '<p><strong>Total Meetings (>12 min):</strong> ' + filteredCount + '</p>' +
      '<hr style="border: 0; border-top: 2px solid #4285f4; margin-bottom: 20px;">' +
      blocksHtml +
    '</div>';

    // 5. Send Email
    var recipient = Session.getActiveUser().getEmail();
    MailApp.sendEmail({
      to: recipient,
      subject: "Google Meet 7-Day Summary Report",
      htmlBody: htmlBody
    });

    Logger.log("Successfully sent 7-day formatted report to " + recipient);

  } catch (err) {
    Logger.log("Error generating 7-day report: " + err.toString());
  }
}

