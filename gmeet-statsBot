/**
 * Helper function to format client types object into a string
 */
function formatClientTypes(clientTypesObj) {
  var keys = Object.keys(clientTypesObj);
  if (keys.length === 0) return "N/A";
  return keys.map(function(k) { return k + ": " + clientTypesObj[k]; }).join(", ");
}

/**
 * Helper function to look up Title, Details, Scheduled Times & Calculate Duration from Calendar
 */
function getCalendarEventDetails(eventId, organizerEmail) {
  if (!eventId || eventId === "N/A") {
    return { title: "N/A", description: "No details provided", scheduledTime: "N/A", repeatDays: "No", durationSec: 0, formattedDuration: "0 min", startDate: null, endDate: null };
  }

  try {
    var calendar = CalendarApp.getCalendarById(organizerEmail) || CalendarApp.getDefaultCalendar();
    var event = calendar.getEventById(eventId);

    if (event) {
      var rawDesc = event.getDescription() || "No details provided";
      var cleanDesc = rawDesc.replace(/<[^>]*>?/gm, '').substring(0, 100);
      if (rawDesc.length > 100) cleanDesc += "...";

      var startTime = event.getStartTime();
      var endTime = event.getEndTime();
      
      var durationSec = Math.floor((endTime.getTime() - startTime.getTime()) / 1000);
      var formattedDuration = formatSecondsToDuration(durationSec);

      var timeOptions = { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' };
      var formattedTiming = startTime.toLocaleDateString(undefined, timeOptions) + " - " + endTime.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });

      var repeatDays = event.isRecurringEvent() ? "Yes" : "No";

      return {
        title: event.getTitle() || "Untitled Event",
        description: cleanDesc,
        scheduledTime: formattedTiming,
        repeatDays: repeatDays,
        durationSec: durationSec,
        formattedDuration: formattedDuration,
        startDate: startTime,
        endDate: endTime
      };
    }
  } catch (e) {
    Logger.log("Could not fetch calendar event ID " + eventId + ": " + e.message);
  }

  return { title: "Not Found / Restricted", description: "No details provided", scheduledTime: "N/A", repeatDays: "No", durationSec: 0, formattedDuration: "0 min", startDate: null, endDate: null };
}

/**
 * Helper function to convert seconds to human-readable strings.
 */
function formatSecondsToDuration(totalSec) {
  if (!totalSec || isNaN(totalSec) || !isFinite(totalSec) || totalSec <= 0) {
    return "0 min";
  }
  var hours = Math.floor(totalSec / 3600);
  var minutes = Math.floor((totalSec % 3600) / 60);

  if (hours > 0) {
    return hours + " hr " + minutes + " min";
  }
  return minutes + " min";
}

/**
